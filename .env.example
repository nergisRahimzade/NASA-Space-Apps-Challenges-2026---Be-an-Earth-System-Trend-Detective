# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# Needed for AI explanations. Without it, explain() uses fallback text.
OPENAI_API_KEY=

# Optional settings. The values below are the defaults.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_S=15
# RESULTS_PATH=results.mock.json
# EXPLAIN_CACHE_PATH=data/cache/explanations.json
# LOG_LEVEL=INFO
