# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# Needed for AI explanations. Without it, explain() uses fallback text.
OPENAI_API_KEY=

# if you're using Gemini key, add these 2 lines in. otherwise, ignore if youre on openaikey.
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#OPENAI_MODEL=gemini-3.8-flash

# Optional settings. The values below are the defaults.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_S=15
# RESULTS_PATH=results.mock.json
# EXPLAIN_CACHE_PATH=data/cache/explanations.json
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:8501
# RATE_LIMIT_PER_MINUTE=60

# Used by the dashboard and scripts/smoke_test.py to find the API.
# API_URL=http://localhost:8000
